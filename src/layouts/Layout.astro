---
import PalestineBanner from "../components/PalestineBanner.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Cursor from "../components/Cursor.astro";
import GithubIcon from "../icons/github.astro";
import LinkedinIcon from "../icons/linkedin.astro";
import MediumIcon from "../icons/medium.astro";
export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Wasif is a software engineer with 5+ years of experience building APIs, web apps and a few things in between. Google Code-in 2019 Runner Up.",
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const navLinks = [
  { href: "/about", text: "About" },
  { href: "/experience", text: "Experience" },
  { href: "/projects", text: "Projects" },
  { href: "/education", text: "Education" },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/icon.png" />
    <meta name="theme-color" content="#5b4bd6" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <script is:inline>
      // Set the theme before first paint so there is no flash of the wrong one.
      (function () {
        var theme = "light";
        try {
          theme =
            localStorage.getItem("theme") ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
        } catch (e) {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa+Ink:wght@700&family=Inter:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content="https://thewasif.github.io/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://opengraph.b-cdn.net/production/documents/1070d3ed-cabc-4053-9639-8a11f02597a0.png?token=TdwZ_WLXT0j3DDJSGn8tHMSLEvpNDYAKl0ufnrvgY4c&height=285&width=584&expires=33247365255"
    />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="thewasif.github.io" />
    <meta property="twitter:url" content="https://thewasif.github.io/" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://opengraph.b-cdn.net/production/documents/1070d3ed-cabc-4053-9639-8a11f02597a0.png?token=TdwZ_WLXT0j3DDJSGn8tHMSLEvpNDYAKl0ufnrvgY4c&height=285&width=584&expires=33247365255"
    />

    <!-- Meta Tags Generated via https://www.opengraph.xyz -->
  </head>
  <body>
    <Cursor />
    <PalestineBanner />

    <nav>
      <div class="nav-left">
        <ThemeToggle />
        <a href="/" class="brand">
          <h2>محمد واصف</h2>
        </a>
      </div>
      <div class="links">
        {
          navLinks.map((link) => (
            <a href={link.href} class:list={[{ active: path === link.href }]}>
              {link.text}
            </a>
          ))
        }
      </div>
    </nav>

    <div class="twrapper">
      <div class="social">
        <div class="icon">
          <a href="https://github.com/thewasif" target="_blank" aria-label="GitHub">
            <GithubIcon />
          </a>
        </div>
        <div class="icon">
          <a href="https://medium.com/@muhammadwasif" target="_blank" aria-label="Medium">
            <MediumIcon />
          </a>
        </div>
        <div class="icon">
          <a
            href="https://www.linkedin.com/in/muhammad-wasif/"
            target="_blank"
            aria-label="LinkedIn"
          >
            <LinkedinIcon />
          </a>
        </div>
        <div class="vertical-line"></div>
      </div>

      <section class="content">
        <slot />
      </section>
    </div>

    <style is:global>
      :root {
        --background: #fbfaff;
        --surface: #f3f2fb;
        --surface-hover: #edebf9;
        --border: #e5e2f2;
        --text: #14131c;
        --text-light: #5b5872;
        --primary: #5b4bd6;
        --primary-hover: #4a3cc0;
        --primary-soft: rgba(91, 75, 214, 0.14);
        --on-primary: #ffffff;
        --accent-gradient: linear-gradient(
          115deg,
          #5b4bd6,
          #3b82f6 45%,
          #06b6d4
        );
        --shadow: 0 1px 2px rgba(20, 19, 28, 0.04),
          0 8px 24px rgba(20, 19, 28, 0.06);
        --shadow-hover: 0 2px 4px rgba(91, 75, 214, 0.08),
          0 12px 32px rgba(91, 75, 214, 0.14);
        /* legacy aliases */
        --color: var(--text);
        --light-bg: var(--surface);
      }

      html[data-theme="dark"] {
        --background: #0d0e17;
        --surface: #171a29;
        --surface-hover: #1e2133;
        --border: #262a3f;
        --text: #eceaf5;
        --text-light: #9c9ab5;
        --primary: #a5a1ff;
        --primary-hover: #b8b5ff;
        --primary-soft: rgba(165, 161, 255, 0.16);
        --on-primary: #0d0e17;
        --accent-gradient: linear-gradient(
          115deg,
          #a5a1ff,
          #7dd3fc 50%,
          #5eead4
        );
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 24px rgba(0, 0, 0, 0.35);
        --shadow-hover: 0 2px 4px rgba(0, 0, 0, 0.35),
          0 12px 32px rgba(0, 0, 0, 0.45);
      }

      html {
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        background-color: var(--background);
        color: var(--text);
        margin: 0;
        padding: 0;
        scroll-behavior: smooth;
        transition: background-color 0.25s ease;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: var(--background);
        transition: background-color 0.25s ease, color 0.25s ease;
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          scroll-behavior: auto;
        }
      }

      main {
        margin: auto;
        padding: 3rem 1.5rem 5rem 1.5rem;
        max-width: 900px;
        width: 100%;
        box-sizing: border-box;
      }

      code {
        font-family: Menlo, Monaco, Lucida Console, Liberation Mono,
          DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, monospace;
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 0.7rem 1.2rem;
        position: sticky;
        top: 0;
        z-index: 20;
        background-color: var(--background);
        border-bottom: 1px solid transparent;
        transition: border-color 0.25s ease, background-color 0.25s ease;
      }

      @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
        nav {
          background-color: color-mix(
            in srgb,
            var(--background) 80%,
            transparent
          );
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
        }
      }

      nav.scrolled {
        border-bottom-color: var(--border);
      }

      .nav-left {
        display: flex;
        align-items: center;
        gap: 0.9rem;
      }

      .brand h2 {
        margin: 0;
        font-family: "Aref Ruqaa Ink", serif;
        color: var(--text);
        user-select: none;
        transition: color 0.2s ease, transform 0.2s ease;
      }

      .brand:hover h2 {
        color: var(--primary);
        transform: translateY(-1px);
      }

      .twrapper {
        display: flex;
        width: 92%;
        margin: 0 auto;
      }

      .content {
        width: 100%;
      }

      @media (min-width: 860px) {
        .twrapper {
          width: 78%;
        }
      }

      .links {
        display: flex;
        gap: 1.2rem;
      }

      .links a {
        position: relative;
        text-decoration: none;
        color: var(--text-light);
        font-size: 0.95rem;
        font-weight: 500;
        padding: 0.2rem 0;
        transition: color 0.2s ease;
      }

      .links a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;
        height: 2px;
        width: 100%;
        border-radius: 2px;
        background: var(--accent-gradient);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.25s ease;
      }

      .links a:hover {
        color: var(--text);
      }

      .links a:hover::after,
      .links a.active::after {
        transform: scaleX(1);
      }

      .links a.active {
        color: var(--primary);
      }

      .social {
        position: fixed;
        bottom: 0;
        left: 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.9rem;
      }

      .social .icon {
        color: var(--text-light);
        display: flex;
        transition: color 0.2s ease, transform 0.2s ease;
      }

      .social .icon:hover {
        color: var(--primary);
        transform: translateY(-3px);
      }

      .social .icon a {
        display: flex;
        color: inherit;
      }

      .vertical-line {
        width: 1px;
        height: 90px;
        margin-top: 0.4rem;
        background: linear-gradient(to bottom, var(--border), transparent);
      }

      a {
        text-decoration: none;
      }

      @media (max-width: 1200px) {
        .social {
          display: none;
        }
      }

      @media (max-width: 560px) {
        nav {
          padding: 0.6rem 1rem;
        }
        .brand h2 {
          font-size: 1.3rem;
        }
        .links {
          gap: 0.85rem;
        }
        .links a {
          font-size: 0.8rem;
        }
        main {
          padding: 2rem 0.2rem 4rem 0.2rem;
        }
      }

      @media (max-width: 420px) {
        .brand {
          display: none;
        }
      }

      ::selection {
        background-color: var(--primary);
        color: white;
      }

      /* Custom Scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }

      ::-webkit-scrollbar-track {
        background: var(--surface);
      }

      ::-webkit-scrollbar-thumb {
        background: var(--border);
        border-radius: 10px;
        transition: background 0.2s ease;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: var(--primary);
      }
    </style>

    <script is:inline>
      (function () {
        var nav = document.querySelector("nav");
        if (!nav) return;
        var sync = function () {
          nav.classList.toggle("scrolled", window.scrollY > 4);
        };
        sync();
        window.addEventListener("scroll", sync, { passive: true });
      })();
    </script>
  </body>
</html>
