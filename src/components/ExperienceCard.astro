---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  image: string;
  links: { text: string; href: string }[];
}
const { title, subtitle, description, links, image } = Astro.props;
---

<div class="wrapper">
  <article class="card">
    <div class="header">
      <img src={image} alt="" loading="lazy" />
      <div class="title">
        <h3>{title}</h3>
        <p>{subtitle}</p>
      </div>
    </div>
    <p class="details">{description}</p>
    <div class="footer">
      {
        links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener">
            {link.text}
            <span class="arrow">→</span>
          </a>
        ))
      }
    </div>
  </article>
</div>

<style>
  .wrapper {
    border-left: 1px solid var(--border);
    position: relative;
    padding: 0 0 1.4rem 1.6rem;
  }

  .wrapper:last-child {
    padding-bottom: 0;
  }

  .wrapper::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.4rem;
    width: 9px;
    height: 9px;
    background-color: var(--border);
    border-radius: 50%;
    transform: translateX(-50%);
    transition: background-color 0.25s ease, box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .wrapper:hover::before {
    background-color: var(--primary);
    box-shadow: 0 0 0 4px var(--primary-soft);
    transform: translateX(-50%) scale(1.15);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem 1.1rem;
    max-width: 640px;
    border: 1px solid transparent;
    border-radius: 14px;
    color: var(--text);
    transition: transform 0.2s ease, border-color 0.2s ease,
      box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .wrapper:hover .card {
    transform: translateX(4px);
    border-color: var(--border);
    background-color: var(--surface);
    box-shadow: var(--shadow);
  }

  .card:active {
    transform: translateX(2px);
  }

  .header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header img {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    object-fit: cover;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .wrapper:hover .header img {
    transform: scale(1.06);
  }

  .header .title h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
  }

  .header .title p {
    margin: 0.1rem 0 0 0;
    font-size: 0.78rem;
    color: var(--text-light);
  }

  .details {
    margin: 0;
    color: var(--text-light);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }

  .footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--primary);
    font-size: 0.83rem;
    font-weight: 500;
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .footer a:hover {
    color: var(--primary-hover);
    gap: 0.45rem;
  }

  .arrow {
    transition: transform 0.2s ease;
  }

  .footer a:hover .arrow {
    transform: translateX(2px);
  }

  @media (max-width: 560px) {
    .wrapper {
      padding-left: 1rem;
    }
    .card {
      padding: 0.9rem 0.8rem;
    }
  }
</style>
