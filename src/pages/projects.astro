---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
---

<Layout
  title="Projects - Muhammad Wasif"
  description="A few projects worth showing — health apps, cross-chain DEX aggregators and a metaverse cricket stadium."
>
  <main>
    <h1>Projects</h1>
    <p class="intro">
      Hundreds of sites and apps over the years. Here are the ones worth
      showing.
    </p>

    <div class="grid">
      <Card
        title="club."
        description="A motivation app that turns verified steps, workouts and sleep into real prizes. I built the backend — health data from wearables, plus the clubs and challenges users compete in."
        subtitle="Gamified health & fitness"
        links={[
          {
            text: "Google Play",
            href: "https://play.google.com/store/apps/details?id=io.club.com",
          },
          {
            text: "App Store",
            href: "https://apps.apple.com/tr/app/club-gamified-health-fitness/id6752398669",
          },
          { text: "Website", href: "https://www.club.xyz/" },
        ]}
        image="/images/clubicon.webp"
      />

      <Card
        title="IU Meta Stadium"
        description="A 3D stadium in Decentraland owned by Islamabad United, next door to LaLiga Land. Visitors complete challenges for NFTs and wearables. I built and deployed it with the Decentraland SDK in TypeScript."
        subtitle="World's first cricket metaverse stadium"
        links={[
          { text: "Website", href: "https://metastadium.io/stadium" },
          {
            text: "Visit stadium",
            href: "https://play.decentraland.org/?NETWORK=mainnet&position=-146%2C76&realm=dg&island=dg2wxn",
          },
        ]}
        image="/images/u-meta.png"
      />

      <Card
        title="Atlas DEX"
        description="The first cross-chain aggregator from Solana to EVM chains — swap, stake and unstake across networks. I handled the responsive frontend and wired up the APIs and contracts."
        subtitle="Cross-chain DEX aggregator"
        links={[
          { text: "Visit app", href: "https://app.atlasdex.finance/swap" },
        ]}
        image="/images/atlas.png"
      />
    </div>
  </main>
</Layout>

<style>
  h1 {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem 0;
    color: var(--text);
  }

  .intro {
    max-width: 58ch;
    margin: 0 0 2.2rem 0;
    color: var(--text-light);
    line-height: 1.65;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 1rem;
  }

  @media (max-width: 560px) {
    .intro {
      font-size: 0.9rem;
    }
  }
</style>
