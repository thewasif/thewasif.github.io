---
import Layout from "../layouts/Layout.astro";
import Experience from "../components/ExperienceCard.astro";
---

<Layout
  title="Experience - Muhammad Wasif"
  description="5+ years across fintech, Web3 and consumer apps — backend services, APIs and CI/CD."
>
  <main>
    <h1>Experience</h1>
    <p class="intro">
      Five years across fintech, Web3 and consumer apps. Mostly backend, always
      close to production.
    </p>

    <div class="timeline">
      <Experience
        title="Relm"
        description="Backend engineer on a fintech product. I design and build the services and APIs behind the financial side of the app, and keep performance and data security honest."
        subtitle="Backend Engineer · Oct 2025 — Present"
        image="/images/relm.ico"
        links={[{ text: "Visit website", href: "https://www.relm.co/" }]}
      />

      <Experience
        title="Amjeo Studio"
        description="Built and scaled backend services for an app with 10k+ active users, and owned the CI/CD pipelines that got everything to production."
        subtitle="Software Engineer · May 2024 — Sept 2025"
        image="/images/amjeo.svg"
        links={[{ text: "Visit website", href: "https://www.amjeo.com/" }]}
      />

      <Experience
        title="Ideofuzion (Pvt.) Ltd."
        description="Web3, mostly. DApps, NFT marketplaces and Decentraland worlds — React and Next.js on the front, NestJS and GraphQL behind it, all in TypeScript."
        subtitle="Software Engineer · Sept 2021 — April 2024"
        image="/images/ideofuzion.jpeg"
        links={[{ text: "Visit website", href: "https://ideofuzion.com/" }]}
      />

      <Experience
        title="FOSSASIA"
        description="Two months of fixing issues and shipping improvements across FOSSASIA's open source projects during Google Code-in 2019. Finished as Runner Up — the first Pakistani student to do so."
        subtitle="Google Code-in · Dec 2019 — Feb 2020"
        image="/images/fossasia.jpeg"
        links={[
          {
            text: "Winners list",
            href: "https://codein.withgoogle.com/archive/2019/",
          },
          {
            href: "https://www.dropbox.com/s/rg2s4ikqeib2dxh/GCI%202019%20Certificate%206571372227067904.pdf?dl=0",
            text: "Certificate",
          },
        ]}
      />
    </div>
  </main>
</Layout>

<style>
  h1 {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem 0;
    color: var(--text);
  }

  .intro {
    max-width: 58ch;
    margin: 0 0 2.5rem 0;
    color: var(--text-light);
    line-height: 1.65;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 560px) {
    .intro {
      font-size: 0.9rem;
    }
  }
</style>
