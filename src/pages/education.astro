---
import Layout from "../layouts/Layout.astro";
import Course from "../components/Course.astro";
---

<Layout
  title="Education - Muhammad Wasif"
  description="Mostly self-taught — Coursera, edX and freeCodeCamp, plus a BS CS ADP at Virtual University of Pakistan."
>
  <main>
    <h1>Education</h1>
    <p class="intro">
      Mostly self-taught. I'm enrolled in the BS Computer Science ADP program at
      Virtual University of Pakistan, but most of the credit goes to Coursera,
      edX and freeCodeCamp.
    </p>
    <p class="intro">
      Design patterns, OOD, data structures and algorithms — plus calculus and
      discrete math, which I enjoyed more than expected.
    </p>

    <section class="courses">
      <Course
        name="Design Patterns"
        university="University of Alberta"
        link={"https://www.coursera.org/account/accomplishments/verify/YWWCSJG7D26G"}
        icon="/images/coursera.jpeg"
      />
      <Course
        name="Object Oriented Design"
        university="University of Alberta"
        link={"https://www.coursera.org/account/accomplishments/verify/ZSU8ELJDVTSK"}
        icon="/images/coursera.jpeg"
      />
      <Course
        name="JS Algorithms & Data Structures"
        university="freeCodeCamp"
        link={"https://www.freecodecamp.org/certification/fcca89724bd-8a87-4e93-8a7c-29324c314330/javascript-algorithms-and-data-structures"}
        icon="/images/freecodecamp.jpeg"
      />
      <Course
        name="Mathematical Thinking in CS"
        university="UC San Diego"
        link={"https://www.coursera.org/account/accomplishments/verify/BA72VFZZPYKB"}
        icon="/images/coursera.jpeg"
      />
      <Course
        name="Developing Cloud Native Applications"
        university="IBM"
        link={"https://www.coursera.org/account/accomplishments/verify/WXKPAS89C8UY"}
        icon="/images/coursera.jpeg"
      />
    </section>
  </main>
</Layout>

<style>
  h1 {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem 0;
    color: var(--text);
  }

  .intro {
    max-width: 62ch;
    margin: 0 0 1rem 0;
    color: var(--text-light);
    line-height: 1.7;
  }

  .courses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.9rem;
    margin-top: 2rem;
  }

  @media (max-width: 560px) {
    .intro {
      font-size: 0.9rem;
    }
  }
</style>
